{
  "version": 1,
  "schedule": {"cron": "17 6,11,16 * * *", "timezoneNote": "06:17, 11:17, 16:17 UTC; 08:17, 13:17, 18:17 CEST or 07:17, 12:17, 17:17 CET. GitHub may delay scheduled runs."},
  "network": {
    "timeoutSeconds": 20,
    "maxAttempts": 3,
    "backoffSeconds": [1, 3],
    "minimumDelaySeconds": 1,
    "userAgent": "AI-Onderwijs-Atlas-Maintenance/1.0 (+https://github.com/ECMW/ai-onderwijs-atlas-nederland)"
  },
  "classification": {
    "failureThreshold": 3,
    "missingLinkThreshold": 2,
    "minimumWords": 30,
    "structureDropRatio": 0.45,
    "deadlineTerms": ["deadline", "sluitingsdatum", "aanvragen tot", "open tot", "closing date"],
    "relevantTerms": ["ai", "artificiele intelligentie", "kunstmatige intelligentie", "onderwijs", "training", "subsidie", "call", "pilot", "handreiking", "praktijkvoorbeeld", "ai act", "privacy", "scenariospel", "toekomstscenario", "werkzekerheid"]
  },
  "normalization": {
    "ignoredTags": ["script", "style", "noscript", "svg", "nav", "footer", "header", "form", "dialog"],
    "ignoredTextPatterns": ["^accepteer cookies$", "^cookievoorkeuren$", "^laatst bijgewerkt[: ]", "^\\d{1,2}[:.]\\d{2}$"]
  }
}
